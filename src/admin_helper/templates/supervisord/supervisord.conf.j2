[supervisord]
nodaemon=true
logfile={{ settings.supervisord.log_file_path }}
pidfile={{ settings.supervisord.pid_file_path }}

[unix_http_server]
file={{ settings.supervisord.sock_file_path }}
chmod=0700

[supervisorctl]
serverurl=unix://{{ settings.supervisord.sock_file_path }}

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface{% for program in settings.supervisord.programs %}
    {% include "program.conf.j2" %}
{% endfor %}