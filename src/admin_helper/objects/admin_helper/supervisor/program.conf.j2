[program:{{ program.name }}]
command={{ program.command }}
directory={{ program.cwd.absolute() | ensure_path | as_str }}
user={{ program.user }}
autostart={{ "true" if program.autostart else "false" }}
autorestart={{ "true" if program.autorestart else "false" }}
stdout_logfile={{ program.stdout_logfile_path.absolute() | ensure_parent_path | as_str }}
stdout_logfile_maxbytes={{ program.stdout_logfile_maxbytes }}
stdout_logfile_backups={{ program.stdout_logfile_backups }}
redirect_stderr=false
stdout_events_enabled=true
stderr_events_enabled=true
stopsignal=TERM
stopasgroup=true
killasgroup=true
{#{% if program.environment %}environment={% for key, value in program.environment.items() %}{{ key }}="{{ value }}"{% if not loop.last %},{% endif %}{% endfor %}{% endif %}#}