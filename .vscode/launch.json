{
    // Verwendet IntelliSense zum Ermitteln möglicher Attribute.
    // Zeigen Sie auf vorhandene Attribute, um die zugehörigen Beschreibungen anzuzeigen.
    // Weitere Informationen finden Sie unter https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python-Debugger: Aktuelle Datei",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "jinja": true
        },
        {
            "name": "Python-Debugger: supervisor",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "supervisor",
            ],
            "jinja": true
        },
        {
            "name": "Python-Debugger: Traefik",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "traefik",
            ],
            "jinja": true
        },
        {
            "name": "Python-Debugger: Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "dashboard",
            ],
            "jinja": true
        },
        {
            "name": "Python-Debugger: settings",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "settings"
            ],
            "jinja": true
        },
        {
            "name": "Python-Debugger: module list",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "module",
                "list",
            ],
            "jinja": true
        },
        {
            "name": "Python-Debugger: module ttyd run",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "module",
                "ttyd",
                "run"
            ],
            "jinja": true
        },
        {
            "name": "Python-Debugger: module filebrowser run",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "module",
                "filebrowser",
                "run"
            ],
            "jinja": true
        }
    ]
}