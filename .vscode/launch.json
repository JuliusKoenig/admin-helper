    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python-Debugger: Aktuelle Datei",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/cli/.venv/bin/python",
        },
        {
            "name": "Python-Debugger: Modul",
            "type": "debugpy",
            "request": "launch",
            "module": "admin_helper_cli",
            "python": "${workspaceFolder}/cli/.venv/bin/python",
            "args": [
                "services",
                "traefik",
                // "dashboard"
                // "settings"
            ]
        }
    ]
}